{
  "name": "browser-encrypted-vault",
  "version": "1.0.0",
  "description": "Zero-dependency WebCrypto AES-GCM-256 + PBKDF2 IndexedDB browser key vault with RAM closure isolation and automatic log scrubbing.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "webcrypto",
    "aes-gcm",
    "pbkdf2",
    "indexeddb",
    "vault",
    "keyring",
    "bip39",
    "typescript"
  ],
  "author": "LevCodeLab",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.2",
    "vitest": "^2.1.4"
  }
}
